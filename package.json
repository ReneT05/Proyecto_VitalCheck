{
  "name": "com.example.vitalcheck",
  "displayName": "Viatlcheck",
  "version": "1.0.0",
  "description": "Aplicación Viatlcheck para registro exprés de glucosa y presión arterial.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecosystem:cordova",
    "salud",
    "vitales",
    "diabetes",
    "hipertensión"
  ],
  "author": "Viatlcheck Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "barkoder-cordova": "^1.6.8",
    "cordova-android": "^15.1.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-advanced-http": "^3.3.1",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-firebasex-core": "^2.0.0",
    "cordova-plugin-firebasex-messaging": "^2.0.1"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ],
    "plugins": {
      "cordova-plugin-advanced-http": {
        "ANDROIDBLACKLISTSECURESOCKETPROTOCOLS": "SSLv3,TLSv1"
      },
      "cordova-plugin-firebasex-core": {
        "ANDROID_FIREBASE_CORE_VERSION": "21.1.1",
        "ANDROID_FIREBASE_INSTALLATIONS_VERSION": "19.1.0",
        "ANDROID_GSON_VERSION": "2.14.0"
      },
      "cordova-plugin-firebasex-messaging": {
        "FIREBASE_FCM_AUTOINIT_ENABLED": "true",
        "FIREBASE_MESSAGING_IMMEDIATE_PAYLOAD_DELIVERY": "false",
        "IOS_FCM_ENABLED": "true",
        "IOS_ENABLE_CRITICAL_ALERTS_ENABLED": "false",
        "ANDROID_ICON_ACCENT": "#FFFFFF",
        "ANDROID_FIREBASE_MESSAGING_VERSION": "25.0.2"
      }
    }
  }
}
